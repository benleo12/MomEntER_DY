{
 "description": "Per-scheme MaxEnt reweighting (central + Wan-Li scale/NP variations). For scheme S, per event: w_rew = w0*exp(sum_k schemes[S].lambda_physical[k]*phi_k - schemes[S].log_norm_shift); then the SAME gating as the central file. phi_k and gating identical to lambda_export.json. Variations are first-order (linear-response) propagations of Wan-Li 28-scheme moment shifts; their envelope = the theory scale-uncertainty band.",
 "n_moments": 15,
 "moments": [
  "rt^1×const^0",
  "const^0×lndphi^1",
  "lnrt^1×const^0",
  "const^0×lndphi^2",
  "lnrt^1×dphi^1",
  "lnrt^2×const^0",
  "lnrt^1×lndphi^1",
  "const^0×dphi^1*lndphi^2",
  "lnrt^1×dphi^2",
  "lnrt^2×dphi^1",
  "const^0×dphi^1*lndphi^3",
  "lnrt^2×dphi^2",
  "lnrt^3×dphi^1",
  "const^0×dphi^1*lndphi^4",
  "const^0×dphi^1*lndphi^5"
 ],
 "sig_mode": "stat",
 "penalty_sigma": "theory-stat (+) prior-MC",
 "n_schemes": 29,
 "scheme_names": [
  "central",
  "0p5C0_np",
  "0p5kappa_np",
  "0p5MuBeam",
  "0p5MuBF",
